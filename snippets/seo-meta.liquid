{%- comment -%}
  Social preview tags and structured data.

  Two jobs, one file, because both need the same handful of values (title,
  description, image, url) and deriving them twice is how they drift apart.

  Open Graph matters here more than it looks: the store's second-best channel is
  an Instagram bio link, and links shared into WhatsApp with no og:image render
  as bare grey URLs. That is a click-through cost today, unlike the JSON-LD
  below, which is a search-results cost measured in months.

  The JSON-LD is emitted per template rather than as one blob: Product on a
  product page, CollectionPage on a collection, Article on an article,
  Organization + WebSite on the home page. Anything else gets the organisation
  only. Every interpolated string goes through `| json`, which quotes and
  escapes it — so a product description containing a quote mark cannot break
  the document.
{%- endcomment -%}

{%- liquid
  assign og_type = 'website'
  assign og_title = page_title
  assign og_desc = page_description | default: shop.description
  assign og_image = page_image | default: settings.share_image

  case template.name
    when 'product'
      assign og_type = 'product'
      assign og_title = product.title
      assign og_desc = product.description | strip_html | truncate: 200
      assign og_image = product.featured_media.preview_image
      assign v = product.selected_or_first_available_variant
    when 'collection'
      assign og_title = collection.title
      assign og_desc = collection.description | strip_html | truncate: 200
      assign og_image = collection.image | default: collection.products.first.featured_media.preview_image
    when 'article'
      assign og_type = 'article'
      assign og_title = article.title
      assign og_desc = article.excerpt_or_content | strip_html | truncate: 200
      assign og_image = article.image
  endcase

  if og_desc == blank
    assign og_desc = shop.description
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image %}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif %}
{%- if template.name == 'product' and v %}
  <meta property="product:price:amount" content="{{ v.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if v.available %}in stock{% else %}out of stock{% endif %}">
{%- endif %}
<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
{%- if og_image %}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif %}

{%- if template.name == 'product' -%}
  {%- liquid
    assign r = product.metafields.reviews.rating.value
    assign r_count = product.metafields.reviews.rating_count.value | plus: 0
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "url": {{ canonical_url | json }},
    "sku": {{ v.sku | default: product.id | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if product.featured_media %}
    "image": [
      {%- for m in product.media limit: 5 -%}
        {%- if m.media_type == 'image' -%}
          {{ m.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ],
    {%- endif %}
    {%- comment -%}
      Only emit aggregateRating when a rating actually exists. Google issues a
      manual action for review markup that is not visible on the page, and an
      empty or zero-count rating is exactly that.
    {%- endcomment -%}
    {%- if r and r_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ r.rating | json }},
      "bestRating": {{ r.scale_max | json }},
      "worstRating": {{ r.scale_min | json }},
      "reviewCount": {{ r_count }}
    },
    {%- endif %}
    "offers": {
      "@type": "Offer",
      "price": "{{ v.price | divided_by: 100.0 }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ canonical_url | json }},
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>
{%- elsif template.name == 'collection' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | truncate: 500 | json }},
    "url": {{ canonical_url | json }}
  }
  </script>
{%- elsif template.name == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    {%- if article.image %}
    "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    "mainEntityOfPage": {{ canonical_url | json }}
  }
  </script>
{%- endif -%}

{%- if template.name == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if settings.logo %}
  "logo": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }},
  {%- endif %}
  "areaServed": { "@type": "Country", "name": "United Arab Emirates" }
}
</script>
