{
  "mcpServers": {
    "search-console": {
      "command": "uvx",
      "args": [
        "--with",
        "cryptography<49",
        "mcp-search-console@0.4.1"
      ],
      "env": {
        "GSC_OAUTH_CLIENT_SECRETS_FILE": "${GSC_OAUTH_CLIENT_SECRETS_FILE:-}"
      }
    },
    "dataforseo": {
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server@3.1.1"
      ],
      "env": {
        "DATAFORSEO_LOGIN": "${DATAFORSEO_LOGIN:-}",
        "DATAFORSEO_PASSWORD": "${DATAFORSEO_PASSWORD:-}"
      }
    },
    "squirrelscan": {
      "command": "node_modules/squirrelscan/bin/squirrel",
      "args": [
        "mcp"
      ],
      "env": {
        "NO_TELEMETRY": "1"
      }
    }
  }
}
