{%- comment -%}
  /collections/all is not a collection. It is a built-in Shopify route that lists
  every product, so it has no manual order to set -- nothing in the admin can
  reorder it, which is why it ignored every attempt. The curated order lives in the
  real "all-products" collection, and this swaps it in for that route only, and only
  when the shopper has not chosen a sort of their own. Pick a sort from the dropdown
  and it hands straight back to Shopify.

  This matters more than it looks: the ads land on /collections/all, so this is the
  first thing almost every paid visitor sees.
{%- endcomment -%}
{%- assign coll = collection -%}
{%- if collection.handle == 'all' and collection.sort_by == blank -%}
  {%- assign curated = collections['all-products'] -%}
  {%- if curated != blank and curated.products_count > 0 -%}
    {%- assign coll = curated -%}
  {%- endif -%}
{%- endif -%}
<section class="section" style="background:var(--cream)">
  <div class="wrap" style="position:relative">
    <span class="kicker">{{ 'collections.general.kicker' | t }} · {{ collection.title }}</span>
    <h1 class="h-xl">{{ section.settings.heading | default: collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="lead">{{ collection.description }}</div>
    {%- endif -%}

    <div class="coll-toolbar">
      {%- if collection.all_tags.size > 0 -%}
        <a class="chip {% unless current_tags %}on{% endunless %}" href="{{ collection.url }}">{{ 'collections.general.all' | t }}</a>
        {%- for tag in collection.all_tags limit: 6 -%}
          <a class="chip {% if current_tags contains tag %}on{% endif %}" href="{{ collection.url }}/{{ tag | handle }}">{{ tag }}</a>
        {%- endfor -%}
      {%- else -%}
        <span class="chip on" style="pointer-events:none">{{ 'collections.general.formats_count' | t: count: coll.products_count }}</span>
      {%- endif -%}
      <select onchange="location.href=this.value" aria-label="{{ 'collections.general.sort_label' | t }}">
        {%- assign sorts = 'manual,price-ascending,price-descending,best-selling' | split: ',' -%}
        {%- for s in sorts -%}
          {%- case s -%}
            {%- when 'price-ascending' -%}{%- assign sort_label = 'collections.sorting.price_ascending' | t -%}
            {%- when 'price-descending' -%}{%- assign sort_label = 'collections.sorting.price_descending' | t -%}
            {%- when 'best-selling' -%}{%- assign sort_label = 'collections.sorting.best_selling' | t -%}
            {%- else -%}{%- assign sort_label = 'collections.sorting.featured' | t -%}
          {%- endcase -%}
          <option value="{{ collection.url }}?sort_by={{ s }}" {% if collection.sort_by == s %}selected{% endif %}>{{ sort_label }}</option>
        {%- endfor -%}
      </select>
    </div>

    <div class="grid-products">
      {%- paginate coll.products by 12 -%}
        {%- for product in coll.products -%}
          {% render 'product-card', product: product, tag_label: product.metafields.biod.card_tag %}
        {%- endfor -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading override" }
  ]
}
{% endschema %}
