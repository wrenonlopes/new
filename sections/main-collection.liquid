<section class="section" style="background:var(--cream)">
  <div class="wrap" style="position:relative">
    <img class="page-sticker page-sticker--sm" src="{{ 'sticker-tube.png' | asset_url }}" alt="" style="top:-6px;right:5%" loading="lazy">
    <span class="kicker">Collection · {{ collection.title }}</span>
    <h1 class="h-xl">{{ section.settings.heading | default: collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="lead">{{ collection.description }}</div>
    {%- endif -%}

    <div class="coll-toolbar">
      <a class="chip {% unless current_tags %}on{% endunless %}" href="{{ collection.url }}">All</a>
      {%- for tag in collection.all_tags limit: 6 -%}
        <a class="chip {% if current_tags contains tag %}on{% endif %}" href="{{ collection.url }}/{{ tag | handle }}">{{ tag }}</a>
      {%- endfor -%}
      <select onchange="location.href=this.value">
        {%- assign sorts = 'manual:Featured,price-ascending:Price low to high,price-descending:Price high to low,best-selling:Best selling' | split: ',' -%}
        {%- for s in sorts -%}
          {%- assign pair = s | split: ':' -%}
          <option value="{{ collection.url }}?sort_by={{ pair[0] }}" {% if collection.sort_by == pair[0] %}selected{% endif %}>{{ pair[1] }}</option>
        {%- endfor -%}
      </select>
    </div>

    <div class="grid-products">
      {%- paginate collection.products by 12 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, tag_label: product.metafields.biod.card_tag %}
        {%- endfor -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading override" }
  ]
}
{% endschema %}
