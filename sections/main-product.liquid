{%- assign v = product.selected_or_first_available_variant -%}
<div class="wrap" data-pdp>
  <div class="pdp">
    <div>
      <div class="pdp__main-img">
        {%- if product.metafields.biod.card_tag != blank -%}
          <span class="pcard__tag pcard__tag--hot">{{ product.metafields.biod.card_tag }}</span>
        {%- endif -%}
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}">
        {%- endif -%}
        {%- assign badge_src = product.metafields.biod.image_badges | default: section.settings.image_badges -%}
        {%- if badge_src != blank -%}
          <div class="img-badges" aria-hidden="true">
            {%- assign badge_list = badge_src | split: '|' -%}
            {%- for b in badge_list limit: 3 -%}<span>{{ b | strip }}</span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for image in product.images limit: 6 -%}
            <img src="{{ image | image_url: width: 180 }}" data-full="{{ image | image_url: width: 900 }}"
                 class="{% if forloop.first %}on{% endif %}" alt="{{ image.alt | escape }}" loading="lazy">
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- assign has_benefits = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}{%- assign has_benefits = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_benefits -%}
        <div class="pdp-benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <div class="pb" {{ block.shopify_attributes }}><span>{{ block.settings.emoji }}</span><small>{{ block.settings.label }}</small></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div>
      {%- if product.metafields.biod.kicker != blank -%}
        <div class="pdp__kicker">{{ product.metafields.biod.kicker }}</div>
      {%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- if product.metafields.biod.hook != blank -%}
        <p class="pdp__hook">{{ product.metafields.biod.hook }}</p>
      {%- endif -%}
      {% render 'price', product: product %}
      {%- if product.metafields.biod.unit_note != blank -%}
        <div class="pdp__unit">{{ product.metafields.biod.unit_note }}</div>
      {%- endif -%}

      <form method="post" action="{{ routes.cart_add_url }}" data-ajax-add>
        <input type="hidden" name="id" value="{{ v.id }}">

        {%- if product.selling_plan_groups.size > 0 -%}
          <div class="selling-plans">
            <label class="plan on" data-price="{{ product.price | money }}">
              <input type="radio" name="selling_plan" value="" checked>
              <div><div class="t">One-time purchase</div><div class="s">Just this order</div></div>
              <span class="p">{{ product.price | money }}</span>
            </label>
            {%- for group in product.selling_plan_groups -%}
              {%- for plan in group.selling_plans -%}
                {%- assign alloc = v.selling_plan_allocations | where: 'selling_plan_id', plan.id | first -%}
                <label class="plan" data-price="{{ alloc.price | money }}">
                  <input type="radio" name="selling_plan" value="{{ plan.id }}">
                  <div><div class="t">{{ plan.name }}</div><div class="s">Cancel anytime</div></div>
                  <span class="p">{{ alloc.price | money }}</span>
                </label>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="buy-row">
          <div class="qty-box">
            <button type="button" data-qty-minus aria-label="Decrease">−</button>
            <input type="number" name="quantity" value="1" min="1" max="50" aria-label="Quantity">
            <button type="button" data-qty-plus aria-label="Increase">+</button>
          </div>
          {%- if product.available -%}
            <button type="submit" class="btn btn--ink">{{ 'products.add_to_cart' | t }}</button>
          {%- else -%}
            <button type="button" class="btn btn--outline" disabled>{{ 'products.sold_out' | t }}</button>
          {%- endif -%}
        </div>
      </form>

      {%- assign has_ladder = false -%}
      {%- for i in (1..3) -%}
        {%- assign skey = 'size_' | append: i -%}
        {%- if section.settings[skey] != blank -%}{%- assign has_ladder = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_ladder -%}
        <div class="sizes">
          <div class="sizes__head">Pick your format. <span>bigger = better value. that's it, that's the math.</span></div>
          <div class="sizes__grid">
            {%- for i in (1..3) -%}
              {%- assign skey = 'size_' | append: i -%}
              {%- assign sp = section.settings[skey] -%}
              {%- if sp != blank -%}
                {%- assign tkey = 'size_tag_' | append: i -%}
                {%- assign lkey = 'size_label_' | append: i -%}
                {%- assign here = false -%}
                {%- if sp.id == product.id -%}{%- assign here = true -%}{%- endif -%}
                <a class="size-card{% if here %} on{% endif %}" {% unless here %}href="{{ sp.url }}"{% endunless %}>
                  {%- if section.settings[tkey] != blank -%}<span class="size-card__tag">{{ section.settings[tkey] }}</span>{%- endif -%}
                  {%- if sp.featured_image -%}<img src="{{ sp.featured_image | image_url: width: 300 }}" alt="{{ sp.title | escape }}" loading="lazy">{%- endif -%}
                  <b>{{ section.settings[lkey] | default: sp.title }}</b>
                  <div class="size-card__price">{{ sp.price | money }}{%- if sp.compare_at_price > sp.price %} <s>{{ sp.compare_at_price | money }}</s>{%- endif -%}</div>
                  {%- if sp.metafields.biod.unit_note != blank -%}<div class="size-card__unit">{{ sp.metafields.biod.unit_note }}</div>{%- endif -%}
                  {%- if here -%}<span class="size-card__here">← you're here</span>{%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="trust-tiles">
        <div class="tt"><span>✨</span><div><b>Premium quality</b><small>100% bamboo fibre</small></div></div>
        <div class="tt"><span>🌱</span><div><b>Sustainably made</b><small>biodegrades in months</small></div></div>
        <div class="tt"><span>🚚</span><div><b>Free delivery</b><small>on orders Dhs {{ settings.free_shipping_threshold }}+</small></div></div>
        <div class="tt"><span>🔒</span><div><b>Secure checkout</b><small>cash on delivery available</small></div></div>
      </div>

      {%- if section.settings.show_receipts -%}
        <div class="receipt-strip"><b>Why single-use?</b> In a published study, <b>89%</b> of used hand towels carried coliform bacteria — and dermatologists advise washing a face towel after every single use if you're acne-prone. A fresh sheet skips the whole problem.</div>
      {%- endif -%}

      {%- assign combo = section.settings.combo_product -%}
      {%- if combo != blank and combo.id != product.id -%}
        <div class="combo-up">
          <span class="combo-up__kicker">better together</span>
          <div class="combo-up__row">
            {%- if combo.featured_image -%}<img src="{{ combo.featured_image | image_url: width: 300 }}" alt="{{ combo.title | escape }}" loading="lazy">{%- endif -%}
            <div class="combo-up__body">
              <b>{{ section.settings.combo_heading }}</b>
              <p>{{ section.settings.combo_sub }}</p>
              <div class="combo-up__price">
                {{ combo.price | money }}
                {%- if combo.compare_at_price > combo.price %} <s>{{ combo.compare_at_price | money }}</s> <em>save {{ combo.compare_at_price | minus: combo.price | money }}</em>{%- endif -%}
              </div>
            </div>
            <a class="btn btn--sunrise combo-up__btn" href="{{ combo.url }}">Get both</a>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_reviews -%}
        <div class="pdp-social">
          <div class="pdp-social__score">
            <b>{{ section.settings.review_score }}</b>
            <span>★★★★★</span>
            <small>{{ section.settings.review_count }}</small>
          </div>
          <div class="pdp-social__quote">
            <p>{{ section.settings.review_quote }}</p>
            <span>{{ section.settings.review_who }}</span>
            <a href="/#reviews">see the comment section →</a>
          </div>
          {%- if section.settings.review_video != blank -%}
            <video class="pdp-social__vid" src="{{ section.settings.review_video | asset_url }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="pdp__accs">
        <details open>
          <summary>What it is</summary>
          <div>{{ product.description }}</div>
        </details>
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div>{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_recommendations -%}
    {%- assign pairs = product.metafields.biod.pairs_with.value -%}
    {%- if pairs == blank -%}{%- assign pairs = product.metafields.biod.pairs_well_with.value -%}{%- endif -%}
    {%- if pairs != blank and pairs.count > 0 -%}
      <div style="padding:30px 0 90px">
        <h2 class="h-l reveal" style="margin-bottom:26px">Pairs well with</h2>
        <div class="grid-products" style="margin-top:0">
          {%- for rec in pairs limit: 2 -%}
            {% render 'product-card', product: rec %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "show_receipts", "label": "Show receipts strip", "default": true },
    { "type": "checkbox", "id": "show_recommendations", "label": "Show 'Pairs well with'", "default": true },
    { "type": "text", "id": "image_badges", "label": "Image badges (separate with |)", "default": "100% bamboo|no added fragrance|hypoallergenic", "info": "Override per product with the biod.image_badges metafield" },
    { "type": "header", "content": "Size ladder" },
    { "type": "product", "id": "size_1", "label": "Size 1 (entry)" },
    { "type": "text", "id": "size_tag_1", "label": "Size 1 tag" },
    { "type": "text", "id": "size_label_1", "label": "Size 1 label" },
    { "type": "product", "id": "size_2", "label": "Size 2 (popular)" },
    { "type": "text", "id": "size_tag_2", "label": "Size 2 tag" },
    { "type": "text", "id": "size_label_2", "label": "Size 2 label" },
    { "type": "product", "id": "size_3", "label": "Size 3 (best value)" },
    { "type": "text", "id": "size_tag_3", "label": "Size 3 tag" },
    { "type": "text", "id": "size_label_3", "label": "Size 3 label" },
    { "type": "header", "content": "Combo upsell" },
    { "type": "product", "id": "combo_product", "label": "Combo product" },
    { "type": "text", "id": "combo_heading", "label": "Heading", "default": "The full routine. One checkout." },
    { "type": "text", "id": "combo_sub", "label": "Subtext", "default": "Travel for your bag, XL for your sink. Your future self says thanks." },
    { "type": "header", "content": "Customer proof" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show review card", "default": true },
    { "type": "text", "id": "review_score", "label": "Score", "default": "4.6" },
    { "type": "text", "id": "review_count", "label": "Count line", "default": "100,000+ customers" },
    { "type": "textarea", "id": "review_quote", "label": "Quote", "default": "\"The first towel that didn't leave my cheeks red. Noticed it in week one.\"" },
    { "type": "text", "id": "review_who", "label": "Reviewer", "default": "Mariam A. — Dubai" },
    { "type": "text", "id": "review_video", "label": "Mini video (theme asset)", "default": "review-gayle.mp4" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit icon", "settings": [
      { "type": "text", "id": "emoji", "label": "Emoji", "default": "🌱" },
      { "type": "text", "id": "label", "label": "Label", "default": "Gone in months" }
    ]},
    { "type": "accordion", "name": "Accordion", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "How to use it" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Pull a fresh sheet. Wash like you always do. Pat dry — don't rub. Toss it: it's 100% bamboo fiber and biodegrades in months.</p>" }
    ]}
  ],
  "presets": [{ "name": "Product page" }]
}
{% endschema %}
