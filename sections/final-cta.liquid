<section class="final">
  <div class="wrap">
    <h2 class="h-xl reveal">{{ section.settings.heading }}</h2>
    <p class="reveal">{{ section.settings.subtext }}</p>
    <a class="btn btn--ink reveal" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>
{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The revolution starts with your face." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Dhs 19. One week. Clearer mornings. Worst case, you're out a shawarma." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
