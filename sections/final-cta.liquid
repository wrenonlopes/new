<section class="final">
  <div class="wrap" style="position:relative">
    {%- if section.settings.show_sticker -%}
      <span class="final__sticker" aria-hidden="true"><img src="{{ 'sticker-travel.png' | asset_url }}" alt="" loading="lazy"></span>
    {%- endif -%}
    <span class="final__pill reveal">{{ section.settings.pill }}</span>
    <h2 class="h-xl reveal">{{ section.settings.heading }}<span class="final__dots" aria-hidden="true"><i>.</i><i>.</i><i>.</i></span></h2>

    {%- if section.settings.show_loader -%}
      <div class="final__loader reveal" data-loader aria-hidden="true">
        <div class="final__bar"><i data-loader-fill></i></div>
        <div class="final__pct"><span data-loader-pct>0</span>%</div>
      </div>
      <p class="final__wink reveal">{{ section.settings.wink }}</p>
    {%- endif -%}

    <p class="final__sub reveal">{{ section.settings.subtext }}</p>
    <a class="btn btn--ink btn--xl reveal" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
    <div class="final__micro reveal">{{ section.settings.microcopy }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "last call bestie" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your clear skin era is loading" },
    { "type": "checkbox", "id": "show_loader", "label": "Show loading bar", "default": true },
    { "type": "text", "id": "wink", "label": "Loader wink line", "default": "(the last 1% is you, clicking the button)" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Dhs 19. One week. Clearer mornings. Worst case, you're out a shawarma." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Finish the download" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "free delivery over Dhs 100 · cash on delivery · your towel could never" },
    { "type": "checkbox", "id": "show_sticker", "label": "Show floating sticker", "default": true }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
