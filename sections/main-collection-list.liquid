<section class="section" style="background:var(--cream)">
  <div class="wrap">
    <span class="kicker">{{ 'collections.list.kicker' | t }}</span>
    <h1 class="h-xl">{{ 'collections.list.title' | t }}</h1>
    <div class="grid-products">
      {%- for collection in collections -%}
        <a class="pcard" href="{{ collection.url }}">
          {%- if collection.featured_image -%}
            <span class="pcard__img"><img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy"></span>
          {%- endif -%}
          <div class="pcard__info" style="padding-bottom:24px">
            <h3 class="pcard__title">{{ collection.title }}</h3>
            <p class="pcard__sub">{{ 'collections.list.product_count' | t: count: collection.products_count }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collection list", "settings": [] }
{% endschema %}
