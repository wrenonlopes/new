<section class="section contact" style="background:var(--cream)">
  <div class="wrap">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h1 class="h-xl">{{ section.settings.heading }}</h1>
    <p class="contact__lead">{{ section.settings.subtext }}</p>

    <div class="contact__grid">
      <div class="contact__formwrap">
        {%- if form.posted_successfully? -%}
          <div class="contact__done">
            <b>{{ 'contact.form.success_title' | t }}</b>
            <p>{{ 'contact.form.success_body' | t }}</p>
          </div>
        {%- endif -%}
        {%- form 'contact' -%}
          {%- if form.errors -%}
            <div class="contact__err">{{ 'contact.form.error' | t }}</div>
          {%- endif -%}
          <div class="contact__row">
            <label>{{ 'contact.form.name' | t }}
              <input type="text" name="contact[name]" required placeholder="{{ 'contact.form.name_placeholder' | t }}">
            </label>
            <label>{{ 'contact.form.email' | t }}
              <input type="email" name="contact[email]" required placeholder="{{ 'contact.form.email_placeholder' | t }}">
            </label>
          </div>
          <label>{{ 'contact.form.phone' | t }} <span class="opt">{{ 'contact.form.optional' | t }}</span>
            <input type="tel" name="contact[phone]" placeholder="{{ 'contact.form.phone_placeholder' | t }}">
          </label>
          <label>{{ 'contact.form.message' | t }}
            <textarea name="contact[body]" rows="5" required placeholder="{{ 'contact.form.message_placeholder' | t }}"></textarea>
          </label>
          <button type="submit" class="btn btn--sunrise btn--xl">{{ 'contact.form.submit' | t }}</button>
        {%- endform -%}
      </div>

      <aside class="contact__side">
        <div class="contact__card">
          <span class="contact__label">{{ 'contact.side.prefer_chat' | t }}</span>
          {%- if settings.whatsapp_url != blank -%}
            <a class="btn btn--ink contact__wa" href="{{ settings.whatsapp_url }}" target="_blank" rel="noopener">💬 {{ 'contact.side.whatsapp' | t }}</a>
          {%- endif -%}
          <p class="contact__wanum">{{ section.settings.whatsapp_display }}</p>
        </div>
        <div class="contact__card">
          <span class="contact__label">{{ 'contact.side.find_us' | t }}</span>
          <p class="contact__addr">{{ section.settings.address }}</p>
        </div>
        <div class="contact__card contact__card--soft">
          <span class="contact__label">{{ 'contact.side.response_time' | t }}</span>
          <p>{{ 'contact.side.response_body' | t }}</p>
        </div>
      </aside>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Contact us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's talk bamboo." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Orders, wholesale, collabs, or a question about your skin — drop us a line and a real human replies." },
    { "type": "text", "id": "whatsapp_display", "label": "WhatsApp number (shown)", "default": "+971 50 977 4289" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Biod co, Maze Tower, DIFC, Dubai, UAE" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
