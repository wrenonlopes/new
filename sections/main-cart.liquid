<section class="section" style="background:var(--cream)">
  <div class="wrap">
    <span class="kicker">{{ 'general.cart.title' | t }}</span>
    <h1 class="h-xl">{{ 'general.cart.heading' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
      {%- if threshold > 0 -%}
        <div class="shipbar">
          {%- if cart.total_price >= threshold -%}
            <div class="t">{{ 'general.cart.free_shipping_unlocked_html' | t }}</div>
            <div class="prog"><i style="width:100%"></i></div>
          {%- else -%}
            {%- assign remaining = threshold | minus: cart.total_price -%}
            {%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}
            {%- assign remaining_money = remaining | money -%}
            <div class="t">{{ 'general.cart.free_shipping_remaining_html' | t: amount: remaining_money }}</div>
            <div class="prog"><i style="width:{{ pct }}%"></i></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post">
        <div class="cart-lines">
          {%- for item in cart.items -%}
            <div class="cline">
              {%- if item.image -%}
                <a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}"></a>
              {%- endif -%}
              <div>
                <div class="cline__name"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
                <div class="cline__meta">
                  {{ item.final_price | money }}
                  {%- if item.selling_plan_allocation -%} · {{ item.selling_plan_allocation.selling_plan.name }}{%- endif -%}
                </div>
              </div>
              <div class="cline__qty">
                <button type="button" data-line-change data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'general.accessibility.decrease' | t }}">−</button>
                <b>{{ item.quantity }}</b>
                <button type="button" data-line-change data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'general.accessibility.increase' | t }}">+</button>
              </div>
              <span class="cline__total">{{ item.final_line_price | money }}</span>
              <button type="button" class="cline__rm" data-line-change data-line="{{ forloop.index }}" data-qty="0" aria-label="{{ 'general.accessibility.remove' | t }}">✕</button>
            </div>
          {%- endfor -%}
        </div>
        <div class="cart-foot">
          {% assign cart_total = cart.total_price | money %}
          <span class="sum">{{ 'general.cart.total' | t: amount: cart_total }}</span>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">{{ 'general.cart.keep_shopping' | t }}</a>
            {%- if request.locale.primary -%}
              <button type="submit" name="checkout" class="btn btn--ink">{{ 'general.cart.checkout' | t }}</button>
            {%- else -%}
              {%- comment -%} Translated storefronts check out in the primary language so orders, emails and the Transcorp/SuiteFleet sync stay English. {%- endcomment -%}
              <button type="submit" form="checkout-primary-locale" class="btn btn--ink">{{ 'general.cart.checkout' | t }}</button>
            {%- endif -%}
          </div>
        </div>
      </form>
      {%- unless request.locale.primary -%}
        {%- assign primary_locale = shop.published_locales | where: 'primary', true | first -%}
        {%- form 'localization', id: 'checkout-primary-locale' -%}
          <input type="hidden" name="locale_code" value="{{ primary_locale.iso_code | default: 'en' }}">
          <input type="hidden" name="return_to" value="/checkout">
        {%- endform -%}
      {%- endunless -%}
      {%- if settings.show_cod -%}
        <p style="margin-top:18px;font-weight:700;font-size:12.5px;color:var(--faint)">{{ 'general.cart.cod_note' | t }}</p>
      {%- endif -%}
    {%- else -%}
      <div class="cart-empty" style="position:relative">
        <span class="page-sticker page-sticker--md" style="top:-34px;inset-inline-end:8%" aria-hidden="true">
          <img src="{{ 'sticker-xl.png' | asset_url }}" alt="" loading="lazy">
        </span>
        <p class="h-m">{{ 'general.cart.empty' | t }}</p>
        <br>
        <a class="btn btn--ink" href="{{ routes.all_products_collection_url }}">{{ 'general.cart.go_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
