<header class="site-header">
  <div class="wrap site-header__in">
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="150" loading="eager">
      {%- else -%}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <nav class="site-nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div style="display:flex;gap:12px;align-items:center">
      <a class="cart-link" href="{{ routes.cart_url }}">Cart · <span data-cart-count>{{ cart.item_count }}</span></a>
      <button class="menu-toggle" aria-label="Menu">☰</button>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
