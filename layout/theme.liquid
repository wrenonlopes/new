<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if request.locale.iso_code == 'ar' %} dir="rtl"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap" rel="stylesheet">
  {%- if request.locale.iso_code == 'ar' -%}
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Bhaijaan+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {%- endif %}

  <style>
    :root{
      --leaf: {{ settings.color_leaf }};
      --leaf-dark: {{ settings.color_leaf_dark }};
      --ink: {{ settings.color_ink }};
      --cream: {{ settings.color_cream }};
      --paper: {{ settings.color_paper }};
      --kraft: {{ settings.color_kraft }};
      --sunrise: {{ settings.color_sunrise }};
      --logo-h: {{ settings.logo_height }}px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">
  {% sections 'header-group' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script>
    window.BIOD = {
      freeShipping: {{ settings.free_shipping_threshold | json }},
      moneyFormat: {{ shop.money_format | json }},
      reveals: {{ settings.enable_reveals | json }},
      marqueeVelocity: {{ settings.marquee_velocity | json }}
    };
    window.BIOD_STRINGS = {
      adding: {{ 'general.ajax_cart.adding' | t | json }},
      added: {{ 'general.ajax_cart.added' | t | json }},
      error: {{ 'general.ajax_cart.error' | t | json }}
    };
  </script>
  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
