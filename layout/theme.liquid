{%- liquid
  # ---------- locale direction ----------
  # Keyed on the primary language subtag, so ar / ar-AE / ar-SA all resolve the same way.
  # Adding another RTL locale later means adding its subtag to rtl_langs and nothing else:
  # base.css flips via logical properties, not via a per-locale override block.
  assign iso = request.locale.iso_code | default: 'en' | downcase
  assign lang = iso | split: '-' | first
  assign rtl_langs = 'ar,ckb,dv,fa,he,ps,sd,ug,ur,yi' | split: ','
  assign text_dir = 'ltr'
  if rtl_langs contains lang
    assign text_dir = 'rtl'
  endif

  # ---------- webfont, per language ----------
  # Outfit and Plus Jakarta Sans carry no Arabic glyphs, so Arabic loads Cairo *instead of*
  # them, not in addition: one variable family (200-1000, Arabic + Latin) covers every
  # weight the theme asks for and keeps "AED" in the same typeface as the Arabic beside it.
  # English pages are byte-for-byte unchanged. Another RTL script needs a `when` branch
  # here plus a matching :lang() rule in base.css; the direction above already works.
  assign google_font = 'Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400'
  case lang
    when 'ar'
      assign google_font = 'Cairo:wght@400..800'
  endcase
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ text_dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ google_font }}&display=swap" rel="stylesheet">

  <style>
    :root{
      --leaf: {{ settings.color_leaf }};
      --leaf-dark: {{ settings.color_leaf_dark }};
      --ink: {{ settings.color_ink }};
      --cream: {{ settings.color_cream }};
      --paper: {{ settings.color_paper }};
      --kraft: {{ settings.color_kraft }};
      --sunrise: {{ settings.color_sunrise }};
      --logo-h: {{ settings.logo_height }}px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">
  {% sections 'header-group' %}

  <main id="MainContent">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}

  {% render 'first-order-popup' %}

  <script>
    window.BIOD = {
      freeShipping: {{ settings.free_shipping_threshold | json }},
      moneyFormat: {{ shop.money_format | json }},
      reveals: {{ settings.enable_reveals | json }},
      marqueeVelocity: {{ settings.marquee_velocity | json }}
    };
  </script>
  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
